{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rekordbot.local/schemas/workflow-import-v2.json",
  "title": "RekordBot workflow metadata import",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "track", "status"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "isrc": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "artist": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["isrc"]},
        {"required": ["title"]},
        {"required": ["artist"]}
      ]
    },
    "status": {"type": ["string", "null"], "enum": ["To Do", "Mood", "Energy", "Tags", "Hot Cues", null]},
    "mood": {
      "oneOf": [
        {"$ref": "#/$defs/mood_pink"},
        {"$ref": "#/$defs/mood_red"},
        {"$ref": "#/$defs/mood_orange"},
        {"$ref": "#/$defs/mood_yellow"},
        {"$ref": "#/$defs/mood_green"},
        {"$ref": "#/$defs/mood_blue"},
        {"$ref": "#/$defs/mood_dark_blue"},
        {"$ref": "#/$defs/mood_purple"}
      ]
    },
    "energy": {"type": "integer", "minimum": 1, "maximum": 5},
    "my_tags": {"$ref": "#/$defs/my_tags"},
    "beatgrid_verified": {"type": "boolean"},
    "quantize_verified": {"type": "boolean"},
    "hot_cues": {
      "type": "array",
      "items": {"$ref": "#/$defs/hot_cue"},
      "allOf": [
        {"contains": {"properties": {"slot": {"const": "A"}}}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"slot": {"const": "B"}}}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"slot": {"const": "C"}}}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"slot": {"const": "D"}}}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"slot": {"const": "E"}}}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"slot": {"const": "F"}}}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"slot": {"const": "G"}}}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"slot": {"const": "H"}}}, "minContains": 0, "maxContains": 1}
      ]
    },
    "desired_playlists": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:Preparation/(?:To Do|Mood|Energy|Tags|Hot Cues|READY)|Mood/[^/\\\\]+|Energy/[1-5]|Genre/[^/\\\\]+|Ann\\u00e9e/[^/\\\\]+|Situation/[^/\\\\]+)$"
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["Energy", "Tags", "Hot Cues"]}}},
      "then": {"required": ["mood"]}
    },
    {
      "if": {"properties": {"status": {"enum": ["Tags", "Hot Cues"]}}},
      "then": {"required": ["energy"]}
    },
    {
      "if": {"properties": {"status": {"const": "Hot Cues"}}},
      "then": {"required": ["my_tags"]}
    },
    {
      "if": {"properties": {"status": {"type": "null"}}},
      "then": {
        "required": ["mood", "energy", "my_tags", "beatgrid_verified", "quantize_verified", "hot_cues"],
        "properties": {
          "beatgrid_verified": {"const": true},
          "quantize_verified": {"const": true},
          "hot_cues": {
            "allOf": [
              {"contains": {"properties": {"slot": {"const": "A"}}, "required": ["slot"]}},
              {"contains": {"properties": {"slot": {"const": "B"}}, "required": ["slot"]}},
              {"contains": {"properties": {"slot": {"const": "C"}}, "required": ["slot"]}},
              {"contains": {"properties": {"slot": {"const": "D"}}, "required": ["slot"]}},
              {"contains": {"properties": {"slot": {"const": "E"}}, "required": ["slot"]}},
              {"contains": {"properties": {"slot": {"const": "H"}}, "required": ["slot"]}}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "mood_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "label"],
      "properties": {
        "color": {"type": "string"},
        "label": {"type": "string"}
      }
    },
    "mood_pink": {"allOf": [{"$ref": "#/$defs/mood_base"}, {"properties": {"color": {"const": "Pink"}, "label": {"const": "Sexy"}}}]},
    "mood_red": {"allOf": [{"$ref": "#/$defs/mood_base"}, {"properties": {"color": {"const": "Red"}, "label": {"const": "\u00c9nergie"}}}]},
    "mood_orange": {"allOf": [{"$ref": "#/$defs/mood_base"}, {"properties": {"color": {"const": "Orange"}, "label": {"const": "Sombre"}}}]},
    "mood_yellow": {"allOf": [{"$ref": "#/$defs/mood_base"}, {"properties": {"color": {"const": "Yellow"}, "label": {"const": "Joie"}}}]},
    "mood_green": {"allOf": [{"$ref": "#/$defs/mood_base"}, {"properties": {"color": {"const": "Green"}, "label": {"const": "Ambiant"}}}]},
    "mood_blue": {"allOf": [{"$ref": "#/$defs/mood_base"}, {"properties": {"color": {"const": "Blue"}, "label": {"const": "Calme"}}}]},
    "mood_dark_blue": {"allOf": [{"$ref": "#/$defs/mood_base"}, {"properties": {"color": {"const": "Dark Blue"}, "label": {"const": "Myst\u00e8re"}}}]},
    "mood_purple": {"allOf": [{"$ref": "#/$defs/mood_base"}, {"properties": {"color": {"const": "Purple"}, "label": {"const": "Triste"}}}]},
    "my_tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genres", "year_origin", "situations"],
      "properties": {
        "genres": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "year_origin": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "situations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "hot_cue_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "name", "color", "position_ms", "phrase_start_verified"],
      "properties": {
        "slot": {"enum": ["A", "B", "C", "D", "E", "F", "G", "H"]},
        "name": {"type": "string"},
        "color": {"type": "string"},
        "position_ms": {"type": "integer", "minimum": 0},
        "phrase_start_verified": {"type": "boolean"},
        "vocal_section_verified": {"type": ["boolean", "null"]},
        "drop_offset_beats": {"type": ["integer", "null"]},
        "loop_beats": {"type": ["integer", "null"], "enum": [8, 16, null]}
      },
      "allOf": [
        {
          "if": {"properties": {"slot": {"not": {"const": "B"}}}},
          "then": {"properties": {"vocal_section_verified": {"enum": [false, null]}}}
        },
        {
          "if": {"properties": {"slot": {"not": {"const": "C"}}}},
          "then": {"properties": {"drop_offset_beats": {"type": "null"}}}
        }
      ]
    },
    "hot_cue": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/hot_cue_base"}, {"properties": {"slot": {"const": "A"}, "name": {"const": "INTRO"}, "color": {"const": "Yellow"}, "phrase_start_verified": {"const": true}, "loop_beats": {"type": "null"}}}]},
        {"allOf": [{"$ref": "#/$defs/hot_cue_base"}, {"required": ["vocal_section_verified"], "properties": {"slot": {"const": "B"}, "name": {"const": "VOCAL"}, "color": {"const": "Pink"}, "vocal_section_verified": {"const": true}, "loop_beats": {"type": "null"}}}]},
        {"allOf": [{"$ref": "#/$defs/hot_cue_base"}, {"required": ["drop_offset_beats"], "properties": {"slot": {"const": "C"}, "name": {"const": "DROP -32"}, "color": {"const": "Green"}, "drop_offset_beats": {"const": 32}, "loop_beats": {"type": "null"}}}]},
        {"allOf": [{"$ref": "#/$defs/hot_cue_base"}, {"properties": {"slot": {"const": "D"}, "name": {"const": "DROP 1"}, "color": {"const": "Red"}, "phrase_start_verified": {"const": true}, "loop_beats": {"type": "null"}}}]},
        {"allOf": [{"$ref": "#/$defs/hot_cue_base"}, {"properties": {"slot": {"const": "E"}, "name": {"const": "BREAKDOWN"}, "color": {"const": "Purple"}, "phrase_start_verified": {"const": true}, "loop_beats": {"type": "null"}}}]},
        {"allOf": [{"$ref": "#/$defs/hot_cue_base"}, {"properties": {"slot": {"const": "F"}, "name": {"const": "PEAK / DROP 2"}, "color": {"const": "Purple"}, "phrase_start_verified": {"const": true}, "loop_beats": {"type": "null"}}}]},
        {"allOf": [{"$ref": "#/$defs/hot_cue_base"}, {"properties": {"slot": {"const": "G"}, "name": {"const": "VOCAL / HOOK"}, "color": {"const": "Pink"}, "phrase_start_verified": {"const": true}, "loop_beats": {"type": "null"}}}]},
        {"allOf": [{"$ref": "#/$defs/hot_cue_base"}, {"required": ["loop_beats"], "properties": {"slot": {"const": "H"}, "name": {"const": "LOOP"}, "color": {"const": "Orange"}, "phrase_start_verified": {"const": true}, "loop_beats": {"enum": [8, 16]}}}]}
      ]
    }
  }
}
